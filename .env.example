# ─────────────────────────────────────────────────────────
#  نمونه پیکربندی ponyDinal
#  این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید.
#  هرگز .env را کامیت یا آپلود نکنید.
# ─────────────────────────────────────────────────────────

# توکن ربات اصلی (از @BotFather)
BOT_TOKEN=

# توکن ربات کمکی/اینلاین (از @BotFather)
HELPER_BOT_TOKEN=

# یوزرنیم ربات کمکی (بدون @)
HELPER_BOT_USERNAME=ShabahHelper_bot

# رمز داخلی کوئری اینلاین پنل — یک رشته تصادفی و خصوصی
# تولید: python3 -c "import secrets;print('shabah_'+secrets.token_urlsafe(24))"
INLINE_SECRET=

# مشخصات اپ API از https://my.telegram.org
API_ID=
API_HASH=

# آیدی عددی مالک (خودتان)
OWNER_ID=
